# Superpowers brainstorming (visual companion mockups, server state)
.superpowers/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project
*.db
*.sqlite
*.log
# uiautomation's library log — gets written to cwd whenever a probe
# script under scripts/ imports the package. Pure noise, never useful
# to track.
@AutomationLog.txt

# Local dependency-resolver lockfiles (project ships with setuptools;
# uv / pdm / poetry locks are personal and shouldn't enter VCS).
uv.lock
pdm.lock
poetry.lock

# Scratch files (commit message buffers, repro scripts)
_*.txt
_*.py
# ...but never ignore Python's package marker, even though it starts
# with an underscore. Without this exception, every new sub-package's
# __init__.py needs `git add -f` to stage.
!__init__.py
# Same exception for private-module files under the package /
# tests trees. Underscore-prefixed module names are a legitimate
# Python convention for "internal, not part of public API"; without
# this rule, files like ``_macos_common.py`` would be silently
# ignored by ``git add`` and flagged as untracked forever.
!claude_island/**/_*.py
!tests/**/_*.py
